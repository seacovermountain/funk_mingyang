-/// 文字生成两个几乎重叠的候选框，各自识别匹配后就会变成两条内容一样
-/// 的记录，保留分数更高的那一条就够了。
-pub fn match_monsters(
-    blocks: &[RawTextBlock],
-    whitelist: &HashSet<String>,
-    cfg: &TextOcrConfig,
